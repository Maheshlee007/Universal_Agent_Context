{
  "name": "universal-agent-context",
  "displayName": "Universal Agent Context (UAC)",
  "description": "Local memory for coding agents: recording toggle, continue-from-session picker, session/knowledge trees, messages and dashboard.",
  "version": "0.3.0",
  "publisher": "uac-dev",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "bundle-cli": "node scripts/bundle-cli.mjs",
    "vscode:prepublish": "node scripts/bundle-cli.mjs"
  },
  "contributes": {
    "commands": [
      { "command": "uac.menu", "title": "Actions…", "category": "UAC" },
      { "command": "uac.toggleCapture", "title": "Start/Stop Recording", "category": "UAC" },
      { "command": "uac.setMode", "title": "Set Mode (off/manual/automatic)", "category": "UAC" },
      { "command": "uac.continueFrom", "title": "Continue from session…", "category": "UAC", "icon": "$(debug-continue)" },
      { "command": "uac.openSession", "title": "Open in dashboard", "category": "UAC" },
      { "command": "uac.deleteSession", "title": "Delete", "category": "UAC" },
      { "command": "uac.deleteEmpty", "title": "Delete empty sessions", "category": "UAC", "icon": "$(trash)" },
      { "command": "uac.sendMessage", "title": "Send message to other sessions", "category": "UAC" },
      { "command": "uac.openViewer", "title": "Open Dashboard", "category": "UAC", "icon": "$(link-external)" },
      { "command": "uac.review", "title": "Review Knowledge", "category": "UAC" },
      { "command": "uac.refresh", "title": "Refresh", "category": "UAC", "icon": "$(refresh)" },
      { "command": "uac.install", "title": "Install for detected tools", "category": "UAC" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "uac", "title": "UAC", "icon": "media/uac.svg" }
      ]
    },
    "views": {
      "uac": [
        { "id": "uac.sessions", "name": "Sessions" },
        { "id": "uac.knowledge", "name": "Knowledge" },
        { "id": "uac.review", "name": "Review" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "uac.continueFrom", "when": "view == uac.sessions", "group": "navigation@1" },
        { "command": "uac.deleteEmpty", "when": "view == uac.sessions", "group": "navigation@2" },
        { "command": "uac.refresh", "when": "view == uac.knowledge || view == uac.review || view == uac.sessions", "group": "navigation@8" },
        { "command": "uac.openViewer", "when": "view == uac.knowledge || view == uac.review || view == uac.sessions", "group": "navigation@9" }
      ],
      "view/item/context": [
        { "command": "uac.continueFrom", "when": "view == uac.sessions && viewItem == session", "group": "1@1" },
        { "command": "uac.openSession", "when": "view == uac.sessions && viewItem == session", "group": "1@2" },
        { "command": "uac.deleteSession", "when": "view == uac.sessions && viewItem == session", "group": "9@1" }
      ],
      "commandPalette": [
        { "command": "uac.openSession", "when": "false" },
        { "command": "uac.deleteSession", "when": "false" }
      ]
    },
    "configuration": {
      "title": "UAC",
      "properties": {
        "uac.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to uac.mjs. Empty = the CLI bundled with the extension (<extension>/cli/bin/uac.mjs)."
        },
        "uac.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Node executable (>= 22.13, needs node:sqlite) used to run the CLI."
        }
      }
    }
  }
}